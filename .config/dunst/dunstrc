[global]
    width = 300
    height = 100
    offset = 24x24
    origin = top-right
    transparency = 10
    frame_color = "#F5C2E7"
    frame_width = 3
    separator_color = frame
    font = Monospace 10
    corner_radius = 8

[urgency_low]
    background = "#1E1E2E"
    foreground = "#CDD6F4"
    frame_color = "#89B4FA"
    timeout = 5

[urgency_normal]
    background = "#1E1E2E"
    foreground = "#CDD6F4"
    frame_color = "#F5C2E7"
    timeout = 5

[urgency_critical]
    background = "#1E1E2E"
    foreground = "#CDD6F4"
    frame_color = "#FAB387"
    timeout = 0
